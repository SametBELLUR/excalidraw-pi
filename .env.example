# Pocket-ID OIDC (or any OIDC provider)
OIDC_ISSUER_URL=https://auth.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URL=https://draw.example.com/auth/callback

# JWT signing — generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-strong-random

# Storage
STORAGE_TYPE=sqlite
DATA_SOURCE_NAME=excalidraw.db
LOCAL_STORAGE_PATH=./data

# Optional
EXCALIDRAW_BACKEND_HOST=        # leave empty for auto-detect from request Host
OPENAI_API_KEY=                 # optional, enables AI chat features
